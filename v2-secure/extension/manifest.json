{
  "manifest_version": 3,
  "name": "JM Stu - Dataview",
  "version": "0.4.0",
  "description": "JellyMedia Studio Dataview — UA team build. Fetches via auth-gated Cloudflare Worker proxy. Adjust API token never leaves the server.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://adjust-roas-proxy.extension-secure.workers.dev/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "JM Stu - Dataview",
    "default_icon": {
      "16": "assets/icons/16.png",
      "32": "assets/icons/32.png",
      "48": "assets/icons/48.png",
      "128": "assets/icons/128.png"
    }
  },
  "icons": {
    "16": "assets/icons/16.png",
    "32": "assets/icons/32.png",
    "48": "assets/icons/48.png",
    "128": "assets/icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://adsmanager.facebook.com/adsmanager/*"
      ],
      "js": ["content/page-bridge.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://adsmanager.facebook.com/adsmanager/*"
      ],
      "js": ["content/meta-injector.js"],
      "css": ["content/meta-injector.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://ads.tiktok.com/i18n/manage/*"
      ],
      "js": ["content/tiktok-page-bridge.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://ads.tiktok.com/i18n/manage/*"
      ],
      "js": ["content/tiktok-injector.js"],
      "css": ["content/meta-injector.css"],
      "run_at": "document_idle"
    }
  ]
}
